import doodleutil.classes.DoodleLevel;
import funkin.save.Save;
import flixel.FlxG;
import funkin.ui.story.StoryMenuState;
import Std;
import funkin.Paths;
import funkin.Assets;
import funkin.util.Constants;

class WeekGhostLevel extends DoodleLevel
{
    public function new()
    {
        super('weekghost', {
            difficulties: ["easy", "normal", "hard", "echo"],
            secretSongs: {
                enabled: true,
                songs: ["illustrious"],
                unlockCondition: {
                    requiredLevel: "weekghost",
                    difficulty: {
                        enabled: true,
                        difficulties: ["hard", "echo"]
                    }
                }
            }
        });
    }

    override public function getSongs():Array<String> {
        return super.getSongs();
    }
}