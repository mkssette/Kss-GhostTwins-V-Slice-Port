import doodleutil.classes.DoodleSong;
import funkin.play.PlayState;
import funkin.play.Countdown;
import funkin.play.PlayStatePlaylist;
import funkin.ui.ScriptedMusicBeatSubState;
import funkin.modding.module.ModuleHandler;
import doodleutil.classes.DoodleUnlockAPI;

class IllustriousSong extends DoodleSong
{
    var endingShown:Bool = false;

    public function new() { 
        super('illustrious', {
            discordRPC: {
                repoUser: "mkssette",
                path: "Kss-GhostTwins-V-Slice-Port/Port-art/discord",
                albumName: "twinsalbum",
                iconName: "icon-twinsfour"
            },
            customUnlockCheck: function() {
                var hardRank = DoodleUnlockAPI.getSavedSongRank("scuffle", "hard");
                var echoRank = DoodleUnlockAPI.getSavedSongRank("scuffle", "echo");
                
                var validRanks = ["PERFECT_GOLD", "PERFECT", "EXCELLENT", "GREAT"];
                
                if (validRanks.contains(hardRank) || validRanks.contains(echoRank)) {
                    return true;
                }
                
                if (DoodleUnlockAPI.hasBeatenSong("illustrious")) {
                    return true;
                }
                
                
                return DoodleUnlockAPI.checkFlag("illustrious_unlocked");
            },
            cutscenes: {
                start: { type: "novel" }
            }
        }); 
    }

    override function onCreate(event:ScriptEvent):Void { 
        super.onCreate(event); 
    }

    override function onSongEnd(event:ScriptEvent) {
        super.onSongEnd(event);

        if (PlayStatePlaylist.isStoryMode && !PlayState.instance.isChartingMode) {
            if (endingShown) return;

            endingShown = true;
            event.cancel();
            
            PlayState.instance.camHUD.visible = false;
            PlayState.instance.camGame.visible = false;
            
            PlayState.instance.openSubState(ScriptedMusicBeatSubState.init('EndingSubState'));
        }
    }
}