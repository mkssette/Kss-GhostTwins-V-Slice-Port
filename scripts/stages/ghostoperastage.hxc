class GhostOperaStage extends DoodleStage {
    function new() {
        super('ghostoperastage');
        
        this.NoteCameraDisplacement = {
            enabled: true,
            strength: 50.0,
            velocity: 1.5,
            speed: 0.7
        };
    }
}
