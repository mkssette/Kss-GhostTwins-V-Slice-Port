  "dialogue": [
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT1",
      "box": "twins",
      "boxAnimation": "talk-gf",
      "speed": 0.05,
      "text": [ "Aqui estamos!" ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT2",
      "box": "twins",
      "boxAnimation": "talk-bf",
      "speed": 0.05,
      "text": [ "Lindo y elegante lugar el que tienen aqui!" ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT3",
      "box": "twins",
      "boxAnimation": "talk-gf",
      "speed": 0.05,
      "text": [ "Gracias, le pertenecia a mi bisabuelo, quien entreno a otros aqui." ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT4",
      "box": "twins",
      "boxAnimation": "talk-gf",
      "speed": 0.05,
      "text": [ "El coro tuvo un accidente aqui, asi que este lugar probablemente esta embrujado." ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT5",
      "box": "twins",
      "boxAnimation": "talk-bf",
      "speed": 0.05,
      "text": [ "De acuerdo entonces. Ejem-" ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT6",
      "box": "twins",
      "boxAnimation": "talk-bf",
      "speed": 0.05,
      "text": [ "Oigan! Hay algun fantasma es-pe-luz-nan-te por aqui?! Vengan a escuchar EL MEJOR CONCIERTO DE SUS (no)VIDAS!!" ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT7",
      "box": "twins",
      "boxAnimation": "talk-gf",
      "speed": 0.05,
      "text": [ "Eso fue lindo, BF." ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT8",
      "box": "twins",
      "boxAnimation": "talk-marie",
      "speed": 0.05,
      "text": [ "TANNER, MIRA! PERSONAS!!" ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT9",
      "box": "twins",
      "boxAnimation": "talk-tanner",
      "speed": 0.05,
      "text": [ "Quien podria ser aho-" ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT10",
      "box": "twins",
      "boxAnimation": "talk-marie",
      "speed": 0.05,
      "text": [ "APUESTO A QUE PUEDEN AYUDARNOS!!" ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT11",
      "box": "twins",
      "boxAnimation": "talk-tanner",
      "speed": 0.05,
      "text": [ "Marie, por favor... No recuerdas al paya-" ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT12",
      "box": "twins",
      "boxAnimation": "talk-gf",
      "speed": 0.05,
      "text": [ "Escuchaste eso?" ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT13",
      "box": "twins",
      "boxAnimation": "talk-tanner",
      "speed": 0.05,
      "text": [ "Hola, amables desconocidos!" ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT14",
      "box": "twins",
      "boxAnimation": "talk-bf",
      "speed": 0.05,
      "text": [ "Bee bo bop" ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT15",
      "box": "twins",
      "boxAnimation": "talk-gf",
      "speed": 0.05,
      "text": [ "Wow! Quienes son ustedes dos?" ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT16",
      "box": "twins",
      "boxAnimation": "talk-tanner",
      "speed": 0.05,
      "text": [ "Ah, supongo que deberia empezar," ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT17",
      "box": "twins",
      "boxAnimation": "talk-tanner",
      "speed": 0.05,
      "text": [ " Yo soy Tanner... y ella es mi hermana mayor, Marie." ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT18",
      "box": "twins",
      "boxAnimation": "talk-marie",
      "speed": 0.05,
      "text": [ "Un gusto conocerlos!" ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT19",
      "box": "twins",
      "boxAnimation": "talk-gf",
      "speed": 0.05,
      "text": [ "Oh, bueno, igualmente! Soy GF, y este es mi novio, BF." ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT20",
      "box": "twins",
      "boxAnimation": "talk-marie",
      "speed": 0.05,
      "text": [ "No tengo idea de como sus padres los llamaron asi, pero, pueden ayudarnos a ascender?" ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT21",
      "box": "twins",
      "boxAnimation": "talk-tanner",
      "speed": 0.05,
      "text": [ "Si, ya que nadie mas p-" ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT22",
      "box": "twins",
      "boxAnimation": "talk-marie",
      "speed": 0.05,
      "text": [ "Como el tipo con mandibula de piedra o el asesino de las gafas rojas!!" ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT23",
      "box": "twins",
      "boxAnimation": "talk-gf",
      "speed": 0.05,
      "text": [ "Como creen que podemos ayudar?" ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT24",
      "box": "twins",
      "boxAnimation": "talk-tanner",
      "speed": 0.05,
      "text": [ "Tal vez una cancion seria lo mas apropiado?" ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT25",
      "box": "twins",
      "boxAnimation": "talk-gf",
      "speed": 0.05,
      "text": [ "BF deberia ser capaz de encargarse de eso!!" ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT26",
      "box": "twins",
      "boxAnimation": "talk-bf",
      "speed": 0.05,
      "text": [ "Beep!" ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT27",
      "box": "twins",
      "boxAnimation": "talk-none",
      "speed": 0.05,
      "text": [ "" ]
    },
    {
      "speaker": "hat-tip-speaker",
      "speakerAnimation": "CUT28",
      "box": "twins",
      "boxAnimation": "talk-tandm",
      "speed": 0.05,
      "text": [ "MUESTRENOS LO QUE TIENEN!!" ]
    }
  ]
}